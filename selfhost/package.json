{
  "name": "wickline-selfhost",
  "private": true,
  "description": "Self-hosted (Docker) edition of Wickline. Lives beside the unmodified upstream app; see ../ARCHITECTURE.md.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/unit/**/*.test.mjs\" \"test/contract/**/*.test.mjs\" \"test/api/**/*.test.mjs\"",
    "test:contract": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/contract/**/*.test.mjs\"",
    "test:unit": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/unit/**/*.test.mjs\"",
    "check:upstream-untouched": "node ci/check-upstream-untouched.mjs",
    "test:api": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/api/**/*.test.mjs\"",
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
